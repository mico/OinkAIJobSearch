# Copy to .env and fill in
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=
STATE_DIR=state

# ── Self-host (download-and-run) — bring your own keys ──────────────────────
# Validate this section any time with:
#   python skill/job-search/scripts/selfhost_preflight.py [--ping]
#
# ALL AI features run on YOUR ChatGPT account through the Codex CLI:
#   npm install -g @openai/codex
#   codex login  # ChatGPT sign-in, as the same OS user that runs the bot
# Required for scoring/audits, profiles, tailoring, fit analysis, and research.
# No provider-selection variables or alternate AI-provider fallback.
# Optional absolute path to Codex when the bot's PATH does not include it.
# OINK_CODEX_BIN=
# Optional model override. If blank, use the default model from the Codex CLI.
# OINK_CODEX_MODEL=
#
# SOURCES — how the job sources are fetched:
#   apify (default) → fetched by the project's published Apify actors run under
#     YOUR APIFY_TOKEN against APIFY_ACTOR_OWNER's account. You pay Apify per
#     run; running our maintained actors is what supports the project.
#   local → scrape in-process (free, no token, but you maintain the scrapers).
# FETCH_BACKEND=apify
# Get a token at https://console.apify.com/account/integrations
APIFY_TOKEN=
# Apify account that owns the published actors (leave as-is to use ours).
APIFY_ACTOR_OWNER=nomad-agent

# --- Social job sources (optional) ---
# Reddit public JSON may return 403. External Data API use requires Reddit
# approval; after approval configure an app at https://www.reddit.com/prefs/apps:
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X: EITHER an X API bearer token with paid API credits for recent search ...
X_BEARER_TOKEN=
# ... OR an Apify tweet-scraper actor (billed to APIFY_TOKEN), e.g. apidojo/tweet-scraper
X_APIFY_ACTOR=

# --- Local Chrome social collection (optional; replaces both API transports) ---
# Load chrome-extension/ as an unpacked extension, then copy its ID here.
# Keep this receiver local: no tunnel or public exposure.
OINK_SOCIAL_BROWSER_ENABLED=
OINK_SOCIAL_BROWSER_EXTENSION_ID=
# Generate with: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the same >=32-character token in the extension's options.
OINK_SOCIAL_BROWSER_TOKEN=

# Continuous mode (recommended, single-user): bot.py runs the search loop
# itself every couple of hours instead of needing an external cron/launchd
# entry. Set both to enable; leave blank for cron/legacy mode. Interval is
# tunable in defaults.py (continuous_interval_seconds, default 7200).
OINK_CONTINUOUS_MODE=
OINK_CONTINUOUS_CHAT_ID=

# Operator chat_id receives monitoring alerts, error reports, and daily run
# summaries. Get it by DMing the bot from your operator account and reading
# bot.log for the chat_id, then paste here. Leave blank to disable monitoring
# delivery (telemetry still records into state/jobs.db).
#
# By default the operator's chat_id is EXCLUDED from continuous auto-search
# (right for the hosted multi-tenant Oink bot, where the operator is the
# maintainer's own monitoring chat, not a real user). This repo's self-host
# mode is single-user only (see README "Who it's for") — the same chat_id IS
# both the operator and the one real user, so if you set OPERATOR_CHAT_ID to
# the same value as OINK_CONTINUOUS_CHAT_ID above, also set
# OINK_CONTINUOUS_INCLUDE_OPERATOR=1 below, or continuous mode will silently
# do nothing for that chat (just a log warning, no error).
OPERATOR_CHAT_ID=
# See OPERATOR_CHAT_ID above. Set to 1 only when OPERATOR_CHAT_ID equals
# your OINK_CONTINUOUS_CHAT_ID (the normal self-host case).
OINK_CONTINUOUS_INCLUDE_OPERATOR=

# Public contact address shown in /privacy and referenced from docs/PRIVACY.md.
OPERATOR_CONTACT=lexsherman.official@gmail.com

# Optional: URL where the hosted privacy policy lives. When set, /privacy
# appends a link to this URL.
PRIVACY_POLICY_URL=

# Optional: chat_id used by tools/demo_ui_to_user.py when no arg is passed.
DEMO_CHAT_ID=

# View-posting redirector — analytics for "View posting ↗" button clicks.
# Telegram URL buttons aren't trackable directly, so when both vars below
# are set the bot rewrites those buttons to point at a signed local
# endpoint that logs the click before 302-ing to the actual URL. Leave
# both blank to keep raw URL buttons (no analytics).
#
# REDIRECT_BASE_URL: PUBLIC https URL fronting the bot's local server.
# Use a tunnel (cloudflared / ngrok / your own reverse proxy on a VPS).
# No trailing slash. Telegram needs HTTPS — http:// won't open.
REDIRECT_BASE_URL=
# REDIRECT_HMAC_SECRET: any random ≥32-char string. Used to sign click
# URLs so they can't be forged. Generate once with
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# and never share it.
REDIRECT_HMAC_SECRET=
# Optional: bind host/port for the local server. Default 127.0.0.1:8765.
# Don't change unless your tunnel needs a different upstream.
REDIRECT_BIND_HOST=127.0.0.1
REDIRECT_BIND_PORT=8765
